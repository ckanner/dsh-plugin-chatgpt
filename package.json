{
  "name": "dsh-plugin-chatgpt",
  "version": "0.1.3",
  "description": "Sign in with ChatGPT inside DeepSeek Harness, and use your ChatGPT subscription to serve models.",
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "dsh",
    "chatgpt",
    "openai",
    "oauth",
    "subscription"
  ],
  "license": "MIT",
  "author": {
    "name": "Kanner",
    "email": "kanner.chen@gmail.com"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ckanner/dsh-plugin-chatgpt.git"
  },
  "homepage": "https://github.com/ckanner/dsh-plugin-chatgpt#readme",
  "bugs": {
    "url": "https://github.com/ckanner/dsh-plugin-chatgpt/issues"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./package.json": "./package.json",
    "./client": {
      "default": "./lib/client.js"
    }
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "locale",
    "screenshots.json",
    "assets",
    "docs/README.zh.md"
  ],
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node scripts/build-client.mjs",
    "typecheck": "tsc -p tsconfig.typecheck.json",
    "test": "node --test \"tests/*.spec.ts\"",
    "prepare": "npm run build",
    "check:i18n": "node scripts/align-readme-i18n.mjs --check",
    "build:client": "node scripts/build-client.mjs",
    "verify:client": "node scripts/verify-client-bundle.mjs",
    "verify:package": "node scripts/verify-package-contents.mjs"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=0.0.1-rc.1 <0.1.0 || >=0.1.0-rc.1 <0.2.0 || >=0.2.0-rc.1 <0.3.0",
    "@deepseek-ai/dsh-llm": ">=0.0.1-rc.1 <0.1.0 || >=0.1.0-rc.1 <0.2.0 || >=0.2.0-rc.1 <0.3.0",
    "@deepseek-ai/dsh-typert-protocol": ">=0.0.1-rc.1 <0.1.0 || >=0.1.0-rc.1 <0.2.0 || >=0.2.0-rc.1 <0.3.0",
    "@deepseek-ai/schemastery": ">=0.0.1-rc.1 <0.1.0 || >=0.1.0-rc.1 <0.2.0 || >=0.2.0-rc.1 <0.3.0"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    },
    "@deepseek-ai/dsh-llm": {
      "optional": true
    },
    "@deepseek-ai/dsh-typert-protocol": {
      "optional": true
    },
    "@deepseek-ai/schemastery": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/react": "^18.3.31",
    "esbuild": "^0.25.12",
    "react": "^18.3.1",
    "typescript": "^5.9.0"
  }
}
