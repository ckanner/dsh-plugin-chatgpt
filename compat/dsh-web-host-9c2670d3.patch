+    return {
+      event,
+      result: {
+        compactionId: event.data.compactionId, startSeq: start.seq, summarySeq: event.seq, endSeq: end.seq,
+        summary: event.data.summary, shadowedRange: event.data.shadowedRange,
+        shadowedSeqs: event.data.shadowedSeqs, shadowedTokenCount: event.data.shadowedTokenCount,
+        ...event.data.sourceCommandId === undefined ? {} : { sourceCommandId: event.data.sourceCommandId },
+      },
+    }
+  }
+  return undefined
+}
+
+/**
+ * Require the original untouched surface and exact contiguous source range.
+ * @param session - logical session held by idle maintenance admission.
+ * @param input - original compaction operation and source node identities.
+ * @param events - explicitly read durable session prefix matching the live surface.
+ * @returns validated positional range suitable for the normal compaction transaction.
+ */
+export function recoveredSummaryRange(
+  session: Session,
+  input: RecoveredSummaryInput,
+  events: readonly SessionEvent[],
+): { start: SessionSeq; end: SessionSeq } {
+  const startEvent = events.find(event =>
+    event.type === 'compaction/start' && event.data.compactionId === input.originalCompactionId)
+  if (startEvent === undefined) throw new ManualCompactionError('changed', 'original compaction operation is not in this session')
+  const nodes = [...session.surface.nodes]
+  if (!isDeepStrictEqual(nodes, [...input.surfaceSeqs])) throw new ManualCompactionError('changed', 'summary adoption surface changed after the original request')
+  const start = input.sourceEventSeqs[0]
+  const end = input.sourceEventSeqs.at(-1)
+  if (start === undefined || end === undefined || input.sourceEventSeqs.some(seq => seq >= startEvent.seq)) {
+    throw new ManualCompactionError('changed', 'recovered summary source range is missing or not from the original operation')
+  }
+  const startIndex = nodes.indexOf(start)
+  const endIndex = nodes.indexOf(end)
+  if (startIndex < 0 || endIndex < startIndex || !isDeepStrictEqual(nodes.slice(startIndex, endIndex + 1), [...input.sourceEventSeqs])) {
+    throw new ManualCompactionError('changed', 'recovered summary source range is no longer contiguous')
+  }
+  const head = nodes[0] === undefined ? undefined : events[nodes[0]]
+  const system = head?.type === 'system/message' ? session.deriveEventMessage(head) : null
+  const messages = input.sourceEventSeqs.flatMap((seq) => {
+    const event = events[seq]
+    if (event === undefined) throw new ManualCompactionError('changed', 'recovered summary source is not durable')
+    const message = session.deriveEventMessage(event)
+    return message === null ? [] : [message]
+  })
+  const original = system === null ? messages : [system, ...messages]
+  if (!isDeepStrictEqual(original, input.request.messages.slice(0, -1))
+    || !isDeepStrictEqual(session.requestHeader()?.tools ?? [], input.request.tools ?? [])) {
+    throw new ManualCompactionError('changed', 'recovered summary source does not match its original request')
+  }
+  return { start, end }
+}
