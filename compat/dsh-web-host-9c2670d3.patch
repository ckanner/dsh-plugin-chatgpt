index 0000000000..d023d3351c
--- /dev/null
+++ b/packages/core/agent-loop/src/recovered-response.ts
@@ -0,0 +1,265 @@
+/** Explicit adoption of a captured response under the Agent's maintenance reservation. */
+
+import { createHash } from 'node:crypto'
+import { isDeepStrictEqual } from 'node:util'
+import type { Context } from '@deepseek-ai/cordis'
+import type { Agent, AgentCancelCause, RecoveredAssistantCommit, RecoveredAssistantResponse } from '@deepseek-ai/dsh-agent'
+import { agentEvents, assembleContextFor } from '@deepseek-ai/dsh-agent'
+import { BlockAssembler, HarnessError, callConfigEquals, createAssistantMessage, errorChain } from '@deepseek-ai/dsh-llm'
+import type { StreamChunk } from '@deepseek-ai/dsh-llm'
+import { ToolCallRecovery } from '@deepseek-ai/dsh-session'
+import type { SessionEvent, TurnEndReason } from '@deepseek-ai/dsh-session'
+import type {} from '@deepseek-ai/dsh-session-persistence'
+import { deepFreeze } from '@deepseek-ai/dsh-util-values'
+import { ToolBatchExecutionError } from '@deepseek-ai/dsh-tools'
+import { AssistantStreamAttempt } from './assistant-stream.ts'
+
+/** A captured response cannot safely enter or finish its host adoption transaction. */
+export class RecoveredResponseError extends HarnessError {
+  /**
+   * @param message - actionable recovery refusal retaining the original response.
+   * @param options - optional underlying failure.
+   */
+  constructor(message: string, options?: ErrorOptions) {
+    super(message, 'RESPONSE_RECOVERY_BLOCKED', options)
+  }
+}
+
+/**
+ * Hash the complete, ordered provider result retained for adoption.
+ * @param chunks - exact serialized chunk sequence from the provider artifact.
+ * @returns lowercase SHA-256, independent of temporary file paths.
+ */
+export function recoveredResponseDigest(chunks: readonly StreamChunk[]): string {
+  return createHash('sha256').update(JSON.stringify(chunks)).digest('hex')
+}
+
+/** Find the original host commit without re-executing any tool. */
+function previousCommit(events: readonly SessionEvent[], input: RecoveredAssistantResponse, assembler: BlockAssembler): SessionEvent<'assistant/message'> | undefined {
+  let headerSeq: number | undefined
+  for (const event of events) {
+    if (event.type === 'request/header') headerSeq = event.seq
+    if (event.type !== 'assistant/message') continue
+    const receipt = event.data.recovered
+    if (receipt === undefined) {
+      // An ordinary response can commit immediately before the external ACK is
+      // lost. The adapter's opaque replay association must identify the same
+      // complete response; plain matching answer text is never identity proof.
+      if (assembler.replayState === undefined || !isDeepStrictEqual(event.data.message.source.replayState, assembler.replayState)) continue
+      if (event.data.interrupted === true || headerSeq !== input.requestHeaderSeq
+        || event.data.message.source.provider !== input.request.provider || event.data.message.source.model !== input.request.model
+        || !isDeepStrictEqual(event.data.message.content, assembler.blocks())) {
+        throw new RecoveredResponseError('recovery association conflicts with an ordinary committed response')
+      }
+      return event
+    }
+    if (receipt.executionDomainId !== input.executionDomainId || receipt.requestId !== input.requestId) continue
+    if (receipt.providerResponseId !== input.providerResponseId || receipt.responseDigest !== input.responseDigest
+      || receipt.requestHeaderSeq !== input.requestHeaderSeq) {
+      throw new RecoveredResponseError('recovery identity conflicts with an already committed response')
+    }
+    return event
+  }
+  return undefined
+}
+
+/** Require the original immutable request surface and route before a new commit. */
+function assertOriginalRequest(agent: Agent, input: RecoveredAssistantResponse, events: readonly SessionEvent[]): void {
+  if (Object.hasOwn(input.request, 'purpose') || input.request.sessionId !== agent.session.id) {
+    throw new RecoveredResponseError('response adoption requires an original main request for this session')
+  }
+  if (!isDeepStrictEqual([...agent.session.surface.nodes], [...input.surfaceSeqs])) {
+    throw new RecoveredResponseError('response adoption surface changed after the original request')
+  }
+  if (!isDeepStrictEqual(agent.session.deriveMessages(), input.request.messages)) {
+    throw new RecoveredResponseError('response adoption messages do not match the original request surface')
+  }
+  const source = events[input.requestHeaderSeq]
+  if (source?.type !== 'request/header'
+    || !callConfigEquals(source.data.header.config, input.request)
+    || !isDeepStrictEqual(source.data.header.tools ?? [], input.request.tools ?? [])) {
+    throw new RecoveredResponseError('response adoption request does not match its durable header')
+  }
+  const currentHeader = events.findLast(event => event.type === 'request/header')
+  if (currentHeader?.seq !== input.requestHeaderSeq) {
+    throw new RecoveredResponseError('response adoption request header changed after the original request')
+  }
+  const selected = agent.model.current()
+  if (selected === undefined || selected.provider !== input.request.provider || selected.model !== input.request.model
+    || (selected.reasoningEffort !== undefined && selected.reasoningEffort !== input.request.reasoningEffort)) {
+    throw new RecoveredResponseError('response adoption requires the original model selection')
+  }
+  if (agent.inbox.nextTurn.length > 0 || agent.inbox.nextStep.length > 0) {
+    throw new RecoveredResponseError('response adoption requires an idle session without queued input')
+  }
+}
+
+/** Explicit recovery needs durable history for identity lookup, not a resident-log assumption. */
+async function persistedEvents(ctx: Context, agent: Agent, signal: AbortSignal): Promise<readonly SessionEvent[]> {
+  const persistence = ctx.get('sessionPersistence')
+  if (persistence === undefined || !await ctx.sessions.flush(agent.session)) {
+    throw new RecoveredResponseError('response adoption requires durable session persistence and a readable backend')
+  }
+  const count = agent.session.seq
+  await using handle = await persistence.open(agent.session.id, 'read', { signal })
+  const { events } = await handle.read(0, count, { signal })
+  if (events.length !== count || agent.session.seq !== count) {
+    throw new RecoveredResponseError('response adoption could not verify an unchanged complete durable session prefix')
+  }
+  return events
+}
+
+/**
+ * Adopt one complete main response into a separately bracketed step. Call only
+ * while the real Agent driver owns its idle maintenance reservation.
+ * @param ctx - driver-owned dependency context.
+ * @param agent - live session owner holding the reservation.
+ * @param source - captured original request and immutable response artifact.
+ * @param signal - maintenance cancellation.
+ * @param nextTurn - reserve the driver's next durable turn number.
+ * @param cancelCause - read cancellation facts from the driver-owned maintenance signal.
+ * @returns the durable message identity; repeated calls never execute tools.
+ */
+export async function adoptRecoveredAssistant(
+  ctx: Context,
+  agent: Agent,
+  source: RecoveredAssistantResponse,
+  signal: AbortSignal,
+  nextTurn: () => number,
+  cancelCause: () => AgentCancelCause | undefined,
+): Promise<RecoveredAssistantCommit> {
+  const { signal: _originalSignal, ...request } = source.request
+  const input = deepFreeze(structuredClone({ ...source, request }))
+  // The original invocation may already have been cancelled. Only the new
+  // maintenance lease controls this separately authorized recovery operation.
+  const operationSignal = signal
+  operationSignal.throwIfAborted()
+  if (Object.hasOwn(input.request, 'purpose') || input.request.sessionId !== agent.session.id) {
+    throw new RecoveredResponseError('response adoption requires an original main request for this session')
+  }
+  if (recoveredResponseDigest(input.chunks) !== input.responseDigest) throw new RecoveredResponseError('recovered response digest mismatch')
+  const last = input.chunks.at(-1)
+  if (last?.type !== 'finish' || (last.reason.kind !== 'stop' && last.reason.kind !== 'tool-calls')) {
+    throw new RecoveredResponseError('response adoption requires a complete successful terminal response')
+  }
+  if (input.chunks.slice(0, -1).some(chunk => chunk.type === 'finish')) throw new RecoveredResponseError('response has multiple terminal chunks')
+  const dispatch = agentEvents(ctx, agent)
+  const payload = { input, signal: operationSignal }
+  if (!dispatch.hasListeners('agent/recovery-check', payload)) throw new RecoveredResponseError('response adoption requires a recovery policy')
+  await dispatch.parallel('agent/recovery-check', payload)
+  operationSignal.throwIfAborted()
+  const assembler = new BlockAssembler()
+  for (const chunk of input.chunks) assembler.push(chunk)
+  const events = await persistedEvents(ctx, agent, operationSignal)
+  const previous = previousCommit(events, input, assembler)
+  if (previous !== undefined) {
+    const durable = await ctx.sessions.flush(agent.session)
+    if (!durable) throw new RecoveredResponseError('response adoption requires durable session persistence')
+    await dispatch.parallel('agent/response-committed', {
+      request: input.request, message: previous.data.message, eventSeq: previous.seq,
+      turn: previous.data.turn, step: previous.data.step, signal: operationSignal, durable,
+    })
+    return { messageId: previous.data.message.id, eventSeq: previous.seq, alreadyCommitted: true, needsContinuation: false }
+  }
+  assertOriginalRequest(agent, input, events)
+  const toolCalls = assembler.blocks().filter(block => block.type === 'tool-call')
+  if (new Set(toolCalls.map(call => call.id)).size !== toolCalls.length) {
+    throw new RecoveredResponseError('recovered response contains duplicate tool call identities')
+  }
+  const toolSet = await ctx.tools.resolve({ agent, modelSelection: input.request, signal: operationSignal })
+  try {
+    const assembly = await ctx.systemPrompt.assemble({
+      ...assembleContextFor(agent, operationSignal), modelSelection: input.request, toolSet,
+    })
+    if (!isDeepStrictEqual(assembly.tools, input.request.tools ?? [])) {
+      throw new RecoveredResponseError('response adoption tool declarations changed after the original request')
+    }
+    for (const call of toolCalls) {
+      if (!toolSet.view(agent).has(call.name)) throw new RecoveredResponseError(`recovered tool ${call.name} is not currently admitted`)
+    }
+    if (!await ctx.sessions.flush(agent.session)) throw new RecoveredResponseError('response adoption requires durable session persistence')
+    operationSignal.throwIfAborted()
+    if (agent.session.seq !== events.length) throw new RecoveredResponseError('response adoption session changed during admission')
+    assertOriginalRequest(agent, input, events)
+    const turn = nextTurn()
+    const step = 1
+    const recovery = new ToolCallRecovery()
+    let turnEnd: TurnEndReason = { kind: 'completed' }
+    let operationFailure: unknown
+    let failed = false
+    let stepOpened = false
+    agent.session.append('turn/start', { turn })
+    const observe = ctx.on('session/event', (session, event) => { if (session === agent.session) recovery.observe(event) })
+    try {
+      agent.session.append('step/start', { turn, step })
+      stepOpened = true
+      const attempt = new AssistantStreamAttempt(agent.session.id, turn, () => 0, turn, step, () => {})
+      for (const chunk of input.chunks) attempt.push(chunk)
+      const message = createAssistantMessage({
+        content: attempt.blocks(),
+        source: {
+          provider: input.request.provider, model: input.request.model,
+          ...attempt.replayState === undefined ? {} : { replayState: attempt.replayState },
+        },
+      })
+      const event = agent.session.append('assistant/message', {
+        turn, step, message, stream: attempt.stream,
+        ...attempt.usage === undefined ? {} : { usage: attempt.usage },
+        recovered: {
+          executionDomainId: input.executionDomainId, requestId: input.requestId,
+          providerResponseId: input.providerResponseId, responseDigest: input.responseDigest,
+          requestHeaderSeq: input.requestHeaderSeq,
+        },
+      }, { surfaceOp: 'append' })
+      const durable = await ctx.sessions.flush(agent.session)
+      if (!durable) throw new RecoveredResponseError('response adoption lost durable persistence before commit')
+      await dispatch.parallel('agent/response-committed', {
+        request: input.request, message, eventSeq: event.seq, turn, step, signal: operationSignal, durable,
+      })
+      operationSignal.throwIfAborted()
+      let needsContinuation = false
+      if (toolCalls.length > 0) {
+        const result = await ctx.tools.execute({
+          calls: toolCalls, agent, signal: operationSignal, log: { turn, step }, toolSet,
+          maxParallelToolCalls: ctx.agentLoop.config.maxParallelToolCalls.get(),
+        })
+        for (const context of result.additionalContexts) agent.inject(context)
+        needsContinuation = !result.concluded
+      }
+      return { messageId: message.id, eventSeq: event.seq, alreadyCommitted: false, needsContinuation }
+    } catch (error: unknown) {
+      failed = true
+      operationFailure = error
+      if (error instanceof ToolBatchExecutionError) {
+        for (const context of error.partial.additionalContexts) agent.inject(context)
+        operationFailure = error.cause
+      }
+      const cause = cancelCause()
+      turnEnd = cause === undefined
+        ? { kind: 'error', error: { code: 'RESPONSE_RECOVERY_FAILED', message: errorChain(operationFailure) } }
+        : { kind: 'aborted', reason: cause }
+      try {
+        for (const event of recovery.results()) {
+          agent.session.append('tool/result', event.data, {
+            surfaceOp: 'append', ...event.sourceEventSeqs === undefined ? {} : { sourceEventSeqs: event.sourceEventSeqs },
+          })
+        }
+      } catch (repairError: unknown) {
+        operationFailure = new AggregateError([operationFailure, repairError], 'recovered response and tool-result repair failed')
+      }
+      throw operationFailure
+    } finally {
+      observe()
+      try {
+        if (stepOpened) agent.session.append('step/end', { turn, step })
+        agent.session.append('turn/end', { turn, reason: turnEnd })
+        if (!await ctx.sessions.flush(agent.session)) throw new RecoveredResponseError('response adoption lost durable persistence at settlement')
+      } catch (settlementError: unknown) {
+        if (failed) throw new AggregateError([operationFailure, settlementError], 'recovered response and durable settlement failed')
+        throw settlementError
+      }
+    }
+  } finally {
+    toolSet.dispose()
+  }
+}
diff --git a/packages/core/agent-loop/tests/host-policy.spec.ts b/packages/core/agent-loop/tests/host-policy.spec.ts
new file mode 100644
index 0000000000..27b053265e
--- /dev/null
+++ b/packages/core/agent-loop/tests/host-policy.spec.ts
@@ -0,0 +1,165 @@
+import { describe, expect, it, onTestFinished, vi } from 'vitest'
+import { Context } from '@deepseek-ai/cordis'
+import AgentLoop from '@deepseek-ai/dsh-agent-loop'
+import { mountAgentLoopTestDependencies } from '@deepseek-ai/dsh-agent-loop-testkit'
+import { brandString } from '@deepseek-ai/dsh-brand'
+import { createUserMessage, LlmError, resolveRetryPolicy } from '@deepseek-ai/dsh-llm'
+import type { SessionId } from '@deepseek-ai/dsh-session'
+import type { Agent } from '@deepseek-ai/dsh-agent'
+import { defineContentToolFixture } from '@deepseek-ai/dsh-tool-testkit'
+import * as LlmRetry from '@deepseek-ai/dsh-llm-retry'
+import { MockAdapter, textResponse, toolCallResponse } from './mock-adapter.ts'
+
+async function harness(adapter: MockAdapter, always = false) {
+  const ctx = new Context()
+  onTestFinished(() => ctx.fiber.dispose())
+  await mountAgentLoopTestDependencies(ctx)
+  await ctx.plugin(AgentLoop, { agents: [] })
+  if (always) vi.spyOn(adapter, 'providerRetryPolicy').mockReturnValue(resolveRetryPolicy({ mode: 'always' }, 'fixture'))
+  ctx.llm.registerAdapter(['mock'], adapter)
+  const agent = await ctx.agentLoop.create(brandString<SessionId>('host-policy'), { provider: 'mock', model: 'mock' })
+  const run = async () => {
+    agent.followup(createUserMessage({ content: [{ type: 'text', text: 'go' }], source: { kind: 'user' } }))
+    await agent.whenIdle()
+  }
+  return { ctx, agent, run }
+}
+
+const failure = { code: 'TIMEOUT', message: 'provider dispatch outcome is unknown' }
+
+describe('provider host policy', () => {
+  it.each(['fulfilled', 'rejected', 'cancelled'] as const)('scopes %s maintenance to its owning Agent and restores the caller', async (settlement) => {
+    const { ctx, agent } = await harness(new MockAdapter([]))
+    const caller = await ctx.agentLoop.create(brandString<SessionId>('maintenance-caller'), { provider: 'mock', model: 'mock' })
+    const entered = Promise.withResolvers<undefined>()
+    const release = Promise.withResolvers<undefined>()
+    const observed: Array<Agent | undefined> = []
+    const failure = new Error('maintenance failed')
+    const cancellation = { kind: 'user' } as const
+    expect(ctx.agents.currentInitiator()).toBeUndefined()
+    await ctx.agents.withInitiator(caller, async () => {
+      const work = agent.runMaintenance(async (signal) => {
+        observed.push(ctx.agents.currentInitiator())
+        entered.resolve(undefined)
+        try {
+          await release.promise
+          observed.push(ctx.agents.currentInitiator())
+          if (settlement === 'rejected') throw failure
+          signal.throwIfAborted()
+          return 'checkpoint'
+        } finally {
+          observed.push(ctx.agents.currentInitiator())
+        }
+      })
+      await entered.promise
+      expect(ctx.agents.currentInitiator()).toBe(caller)
+      if (settlement === 'cancelled') agent.cancel(cancellation)
+      release.resolve(undefined)
+      if (settlement === 'fulfilled') await expect(work).resolves.toBe('checkpoint')
+      else await expect(work).rejects.toBe(settlement === 'rejected' ? failure : cancellation)
+      expect(ctx.agents.currentInitiator()).toBe(caller)
+    })
+    expect(observed.map(initiator => initiator === agent)).toEqual([true, true, true])
+    expect(ctx.agents.currentInitiator()).toBeUndefined()
+    await agent.whenIdle()
+  })
+
+  it('vetoes always retries before recovery without changing the original failure', async () => {
+    const adapter = new MockAdapter([
+      [{ type: 'finish', reason: { kind: 'error', failure } }], textResponse('must not run'),
+    ])
+    const { ctx, agent, run } = await harness(adapter, true)
+    await ctx.plugin(LlmRetry)
+    let checked = false
+    let allListenersRan = false
+    ctx.on('agent/replay-check', ({ request, failure: original }) => {
+      checked = request.sessionId === agent.id && original.code === failure.code
+      throw LlmError.fromFailure(original)
+    })
+    ctx.on('agent/replay-check', () => { allListenersRan = true })
+    await run()
+    expect(checked).toBe(true)
+    expect(allListenersRan).toBe(true)
+    expect(adapter.requests).toHaveLength(1)
+    expect(agent.session.snapshotEvents().filter(event => event.type === 'llm/retry')).toHaveLength(0)
+    expect(agent.session.snapshotEvents().find(event => event.type === 'turn/end')).toMatchObject({
+      data: { reason: { kind: 'error', error: failure } },
+    })
+  })
+
+  it('rechecks persistent policy after a recovery listener returns retry', async () => {
+    const adapter = new MockAdapter([
+      [{ type: 'finish', reason: { kind: 'error', failure } }], textResponse('must not run'),
+    ])
+    const { ctx, run } = await harness(adapter)
+    let fenced = false
+    let checks = 0
+    ctx.on('agent/replay-check', () => {
+      checks += 1
+      if (fenced) throw LlmError.fromFailure(failure)
+    })
+    ctx.on('agent/request-error', async () => {
+      fenced = true
+      return { kind: 'retry' }
+    })
+    await run()
+    expect(checks).toBe(2)
+    expect(adapter.requests).toHaveLength(1)
+  })
+
+  it('acknowledges the complete persisted response before tools execute', async () => {
+    const adapter = new MockAdapter([toolCallResponse('call-1', 'write', {}), textResponse('done')])
+    const { ctx, agent, run } = await harness(adapter)
+    const order: string[] = []
+    ctx.on('session/flush', (session) => {
+      expect(session).toBe(agent.session)
+      order.push('flush')
+    })
+    ctx.on('agent/response-committed', ({ request, eventSeq, message, durable }) => {
+      expect(durable).toBe(true)
+      expect(request).toBe(adapter.requests.at(-1))
+      expect(agent.session.eventAt(eventSeq)).toMatchObject({ type: 'assistant/message', data: { message } })
+      order.push('ack')
+    })
+    ctx.tools.register(defineContentToolFixture({
+      name: 'write', description: 'write one fixture', parameters: {},
+      execute: async () => { order.push('tool'); return [{ type: 'text', text: 'written' }] },
+    }))
+    await run()
+    expect(order.slice(0, 3)).toEqual(['flush', 'ack', 'tool'])
+    expect(adapter.requests).toHaveLength(2)
+  })
+
+  it('does not call ACK or tools when persistence rejects', async () => {
+    const adapter = new MockAdapter([toolCallResponse('call-1', 'write', {})])
+    const { ctx, agent, run } = await harness(adapter)
+    let acknowledgements = 0
+    let writes = 0
+    ctx.on('session/flush', () => { throw new Error('disk unavailable') })
+    ctx.on('agent/response-committed', () => { acknowledgements += 1 })
+    ctx.tools.register(defineContentToolFixture({
+      name: 'write', description: 'write one fixture', parameters: {},
+      execute: async () => { writes += 1; return [{ type: 'text', text: 'written' }] },
+    }))
+    await run()
+    expect(acknowledgements).toBe(0)
+    expect(writes).toBe(0)
+    expect(agent.session.snapshotEvents().filter(event => event.type === 'assistant/message')).toHaveLength(1)
+  })
+
+  it('reports an in-memory response as non-durable and lets policy stop tools', async () => {
+    const adapter = new MockAdapter([toolCallResponse('call-1', 'write', {})])
+    const { ctx, run } = await harness(adapter)
+    let writes = 0
+    ctx.on('agent/response-committed', ({ durable }) => {
+      expect(durable).toBe(false)
+      throw new Error('durable session storage is required')
+    })
+    ctx.tools.register(defineContentToolFixture({
+      name: 'write', description: 'write one fixture', parameters: {},
+      execute: async () => { writes += 1; return [{ type: 'text', text: 'written' }] },
+    }))
+    await run()
+    expect(writes).toBe(0)
+  })
+})
diff --git a/packages/core/agent-loop/tests/recovered-response.spec.ts b/packages/core/agent-loop/tests/recovered-response.spec.ts
