index 0000000000..bc021b9a28
--- /dev/null
+++ b/packages/core/agent-loop/tests/recovered-response.spec.ts
@@ -0,0 +1,189 @@
+import { describe, expect, it, onTestFinished } from 'vitest'
+import { mkdtemp, rm } from 'node:fs/promises'
+import { tmpdir } from 'node:os'
+import { join } from 'node:path'
+import { Context } from '@deepseek-ai/cordis'
+import AgentLoop, { recoveredResponseDigest } from '@deepseek-ai/dsh-agent-loop'
+import { mountAgentLoopTestDependencies } from '@deepseek-ai/dsh-agent-loop-testkit'
+import * as JsonlSessionPersistence from '@deepseek-ai/dsh-session-persistence-jsonl'
+import { brandString } from '@deepseek-ai/dsh-brand'
+import { createUserMessage } from '@deepseek-ai/dsh-llm'
+import type { SessionId } from '@deepseek-ai/dsh-session'
+import type { RecoveredAssistantResponse } from '@deepseek-ai/dsh-agent'
+import { defineContentToolFixture } from '@deepseek-ai/dsh-tool-testkit'
+import { MockAdapter, textResponse, toolCallResponse } from './mock-adapter.ts'
+
+async function pendingResponse(tools = false, ordinaryCommit = false, persistent = true) {
+  const root = await mkdtemp(join(tmpdir(), 'dsh-response-recovery-'))
+  const ctx = new Context()
+  onTestFinished(async () => { await ctx.fiber.dispose(); await rm(root, { recursive: true, force: true }) })
+  await mountAgentLoopTestDependencies(ctx, { workingDirectory: true })
+  if (persistent) await ctx.plugin(JsonlSessionPersistence, { root, compression: 'none' })
+  await ctx.plugin(AgentLoop, { agents: [] })
+  const captured = tools ? toolCallResponse('recovered-tool', 'write', {}) : textResponse('recovered answer')
+  const terminal = captured.at(-1)!
+  if (terminal.type !== 'finish') throw new Error('missing fixture finish')
+  const chunks = [...captured.slice(0, -1), { ...terminal, replayState: { response: { requestId: 'request-1', responseId: 'response-1' } } }]
+  const adapter = new MockAdapter([
+    ordinaryCommit ? chunks : [{ type: 'finish', reason: { kind: 'error', failure: { code: 'TRANSPORT', message: 'lost observer' } } }],
+    textResponse('continued'),
+  ])
+  ctx.llm.registerAdapter(['mock'], adapter)
+  let writes = 0
+  if (tools) ctx.tools.register(defineContentToolFixture({
+    name: 'write', description: 'write fixture', parameters: {},
+    execute: async () => { writes += 1; return [{ type: 'text', text: 'written' }] },
+  }))
+  const agent = await ctx.agentLoop.create(brandString<SessionId>('response-recovery'), { provider: 'mock', model: 'mock' })
+  const prompt = createUserMessage({ content: [{ type: 'text', text: 'original task' }], source: { kind: 'user' } })
+  agent.followup(prompt)
+  await agent.whenIdle()
+  const request = adapter.requests[0]!
+  const header = agent.session.snapshotEvents().findLast(event => event.type === 'request/header')!
+  const input: RecoveredAssistantResponse = {
+    executionDomainId: 'domain-1', requestId: 'request-1', providerResponseId: 'response-1',
+    responseDigest: recoveredResponseDigest(chunks), request, requestHeaderSeq: header.seq,
+    surfaceSeqs: [...agent.session.surface.nodes], chunks,
+  }
+  return { ctx, agent, adapter, input, writes: () => writes }
+}
+
+describe('explicit recovered response adoption', () => {
+  it('requires host recovery policy before committing an assistant response', async () => {
+    const { ctx, agent, input } = await pendingResponse()
+    ctx.on('session/flush', () => {})
+    await expect(ctx.agentLoop.adoptRecoveredResponse(agent, input)).rejects.toThrow('requires a recovery policy')
+    expect(agent.session.snapshotEvents().filter(event => event.type === 'assistant/message')).toHaveLength(0)
+  })
+
+  it('commits one response and tool execution, then returns the same identity for duplicates', async () => {
+    const { ctx, agent, adapter, input, writes } = await pendingResponse(true)
+    ctx.on('session/flush', () => {})
+    ctx.on('agent/recovery-check', ({ input: checked }) => {
+      expect(ctx.agents.currentInitiator()).toBe(agent)
+      expect(checked.requestId).toBe('request-1')
+    })
+    const commit = await ctx.agentLoop.adoptRecoveredResponse(agent, input)
+    expect(commit).toMatchObject({ alreadyCommitted: false, needsContinuation: true })
+    expect(writes()).toBe(1)
+    expect(adapter.requests).toHaveLength(1)
+    const duplicate = await ctx.agentLoop.adoptRecoveredResponse(agent, input)
+    expect(ctx.agents.currentInitiator()).toBeUndefined()
+    expect(duplicate).toEqual({ ...commit, alreadyCommitted: true, needsContinuation: false })
+    expect(writes()).toBe(1)
+    agent.followup(createUserMessage({ content: [{ type: 'text', text: 'continue' }], source: { kind: 'user' } }))
+    await agent.whenIdle()
+    expect(agent.session.snapshotEvents().flatMap(event => event.type === 'turn/start' ? [event.data.turn] : [])).toEqual([1, 2, 3])
+  })
+
+  it('rejects modified response bytes and changed source history before any tool starts', async () => {
+    const { ctx, agent, input, writes } = await pendingResponse(true)
+    ctx.on('session/flush', () => {})
+    ctx.on('agent/recovery-check', () => {})
+    await expect(ctx.agentLoop.adoptRecoveredResponse(agent, { ...input, responseDigest: 'wrong' })).rejects.toThrow('digest mismatch')
+    agent.session.append('user/message', createUserMessage({
+      content: [{ type: 'text', text: 'new task' }], source: { kind: 'user' },
+    }), { surfaceOp: 'append' })
+    await expect(ctx.agentLoop.adoptRecoveredResponse(agent, input)).rejects.toThrow('surface changed')
+    expect(writes()).toBe(0)
+  })
+
+  it('does not adopt compaction output as an ordinary assistant response', async () => {
+    const { ctx, agent, input } = await pendingResponse()
+    ctx.on('session/flush', () => {})
+    ctx.on('agent/recovery-check', () => {})
+    await expect(ctx.agentLoop.adoptRecoveredResponse(agent, {
+      ...input, request: { ...input.request, purpose: 'compaction' },
+    })).rejects.toThrow('original main request')
+  })
+
+  it('rejects a changed request body even when header and surface identities match', async () => {
+    const { ctx, agent, input, writes } = await pendingResponse(true)
+    ctx.on('agent/recovery-check', () => {})
+    await expect(ctx.agentLoop.adoptRecoveredResponse(agent, {
+      ...input, request: { ...input.request, messages: [] },
+    })).rejects.toThrow('messages do not match')
+    expect(writes()).toBe(0)
+    expect(agent.session.snapshotEvents().filter(event => event.type === 'assistant/message')).toHaveLength(0)
+  })
+
+  it('requires real persistence and unchanged admitted tool schemas', async () => {
+    const missing = await pendingResponse(true, false, false)
+    missing.ctx.on('agent/recovery-check', () => {})
+    missing.ctx.on('session/flush', () => {})
+    await expect(missing.ctx.agentLoop.adoptRecoveredResponse(missing.agent, missing.input)).rejects.toThrow('durable session persistence')
+    const { ctx, agent, input, writes } = await pendingResponse(true)
+    ctx.on('agent/recovery-check', () => {})
+    ctx.on('session/flush', () => {})
+    ctx.tools.register(defineContentToolFixture({
+      name: 'other', description: 'new tool changes permissions', parameters: {},
+      execute: async () => [{ type: 'text', text: 'unused' }],
+    }))
+    await expect(ctx.agentLoop.adoptRecoveredResponse(agent, input)).rejects.toThrow('tool declarations changed')
+    expect(writes()).toBe(0)
+  })
+
+  it('holds maintenance admission across asynchronous policy checks', async () => {
+    const { ctx, agent, input } = await pendingResponse()
+    const gate = Promise.withResolvers<undefined>()
+    const entered = Promise.withResolvers<undefined>()
+    ctx.on('session/flush', () => {})
+    ctx.on('agent/recovery-check', async () => { entered.resolve(undefined); await gate.promise })
+    const first = ctx.agentLoop.adoptRecoveredResponse(agent, input)
+    await entered.promise
+    expect(() => ctx.agentLoop.adoptRecoveredResponse(agent, input)).toThrow('active work')
+    gate.resolve(undefined)
+    await expect(first).resolves.toMatchObject({ alreadyCommitted: false })
+  })
+
+  it('finds an ordinary response after its ACK was lost without replaying its tools', async () => {
+    const { ctx, agent, adapter, input, writes } = await pendingResponse(true, true)
+    ctx.on('session/flush', () => {})
+    ctx.on('agent/recovery-check', () => {})
+    const before = agent.session.snapshotEvents().filter(event => event.type === 'assistant/message')
+    const requests = adapter.requests.length
+    const commit = await ctx.agentLoop.adoptRecoveredResponse(agent, input)
+    expect(commit).toMatchObject({ alreadyCommitted: true, eventSeq: before[0]!.seq, needsContinuation: false })
+    expect(writes()).toBe(1)
+    expect(adapter.requests).toHaveLength(requests)
+    expect(agent.session.snapshotEvents().filter(event => event.type === 'assistant/message')).toHaveLength(before.length)
+  })
+
+  it('uses fresh maintenance cancellation instead of the terminated invocation signal', async () => {
+    const { ctx, agent, input } = await pendingResponse()
+    ctx.on('session/flush', () => {})
+    ctx.on('agent/recovery-check', () => {})
+    const expired = AbortSignal.abort(new Error('original observer stopped'))
+    await expect(ctx.agentLoop.adoptRecoveredResponse(agent, { ...input, request: { ...input.request, signal: expired } }))
+      .resolves.toMatchObject({ alreadyCommitted: false })
+  })
+
+  it('preserves cancellation facts and does not start tools after an ACK listener cancels', async () => {
+    const { ctx, agent, input, writes } = await pendingResponse(true)
+    ctx.on('session/flush', () => {})
+    ctx.on('agent/recovery-check', () => {})
+    ctx.on('agent/response-committed', () => { agent.cancel({ kind: 'hook', reason: 'domain quarantined' }) })
+    await expect(ctx.agentLoop.adoptRecoveredResponse(agent, input)).rejects.toEqual({ kind: 'hook', reason: 'domain quarantined' })
+    expect(writes()).toBe(0)
+    const end = agent.session.snapshotEvents().findLast(event => event.type === 'turn/end')
+    expect(end?.data).toMatchObject({ reason: { kind: 'aborted', reason: { kind: 'hook', reason: 'domain quarantined' } } })
+  })
+
+  it('retains the original failure when durable final settlement also fails', async () => {
+    const { ctx, agent, input, writes } = await pendingResponse(true)
+    ctx.on('session/flush', () => {
+      if (agent.session.snapshotEvents().findLast(event => event.type === 'turn/end')?.data.turn === 2) {
+        throw new Error('final storage failed')
+      }
+    })
+    ctx.on('agent/recovery-check', () => {})
+    const original = new Error('ACK failed')
+    ctx.on('agent/response-committed', () => { throw original })
+    let failure: unknown
+    try { await ctx.agentLoop.adoptRecoveredResponse(agent, input) } catch (error: unknown) { failure = error }
+    expect(failure).toBeInstanceOf(AggregateError)
+    expect((failure as AggregateError).errors[0]).toBe(original)
+    expect((failure as AggregateError).errors[1]).toMatchObject({ message: 'final storage failed' })
+    expect(writes()).toBe(0)
+  })
+})
