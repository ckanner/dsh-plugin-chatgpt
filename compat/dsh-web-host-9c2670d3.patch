index 0000000000..94be53dc59
--- /dev/null
+++ b/packages/compaction/compaction-basic/src/recovered-summary.ts
@@ -0,0 +1,139 @@
+/** Validation and durable identity lookup for explicit auxiliary summary adoption. */
+
+import { createHash } from 'node:crypto'
+import { isDeepStrictEqual } from 'node:util'
+import { BlockAssembler, contentHasImage } from '@deepseek-ai/dsh-llm'
+import { ManualCompactionError, type CompactionResult, type RecoveredSummaryInput } from '@deepseek-ai/dsh-compaction'
+import type { Session, SessionEvent, SessionSeq } from '@deepseek-ai/dsh-session'
+import type { SummaryResult } from './summarizer.ts'
+
+/**
+ * Validate the complete successful provider response without any host mutation.
+ * @param session - bound logical session.
+ * @param input - original auxiliary request and complete ordered chunks.
+ * @returns the exact text-only summary and provider call facts.
+ */
+export function recoveredSummaryResult(session: Session, input: RecoveredSummaryInput): SummaryResult {
+  if (input.request.sessionId !== session.id || input.request.purpose !== 'compaction') {
+    throw new ManualCompactionError('changed', 'summary adoption requires the original compaction request for this session')
+  }
+  const digest = createHash('sha256').update(JSON.stringify(input.chunks)).digest('hex')
+  if (digest !== input.responseDigest) throw new ManualCompactionError('changed', 'recovered summary digest mismatch')
+  const terminal = input.chunks.at(-1)
+  if (terminal?.type !== 'finish' || terminal.reason.kind !== 'stop'
+    || input.chunks.slice(0, -1).some(chunk => chunk.type === 'finish')) {
+    throw new ManualCompactionError('changed', 'summary adoption requires one successful complete terminal response')
+  }
+  const assembler = new BlockAssembler()
+  for (const chunk of input.chunks) assembler.push(chunk)
+  const rawOutput = assembler.blocks()
+  if (contentHasImage(rawOutput) || rawOutput.some(block => block.type === 'tool-call')) {
+    throw new ManualCompactionError('changed', 'a recovered summary cannot invoke tools or contain image output')
+  }
+  const summary = rawOutput.filter(block => block.type === 'text')
+  if (!summary.some(block => block.text.trim().length > 0)) throw new ManualCompactionError('changed', 'recovered summary has no text')
+  return {
+    summary, rawOutput, llmStreamCall: true,
+    provider: input.request.provider, model: input.request.model,
+    ...input.request.reasoningEffort === undefined ? {} : { reasoningEffort: input.request.reasoningEffort },
+    ...input.request.maxTokens === undefined ? {} : { maxTokens: input.request.maxTokens },
+    ...assembler.usage === undefined ? {} : { usage: assembler.usage },
+    ...assembler.replayState === undefined ? {} : { replayState: assembler.replayState },
+    recovered: {
+      executionDomainId: input.executionDomainId, requestId: input.requestId,
+      providerResponseId: input.providerResponseId, responseDigest: input.responseDigest,
+      originalCompactionId: input.originalCompactionId,
+    },
+  }
+}
+
+/**
+ * Find an original or adopted committed checkpoint without replacing it again.
+ * @param events - explicitly read durable compaction records.
+ * @param input - requested original provider operation.
+ * @param summary - validated actual response blocks and route.
+ * @returns matching summary event and transaction result, or undefined.
+ */
+export function previousSummaryCommit(
+  events: readonly SessionEvent[],
+  input: RecoveredSummaryInput,
+  summary: SummaryResult,
+): { event: SessionEvent<'compaction/summary'>; result: CompactionResult } | undefined {
+  for (const event of events) {
+    if (event.type !== 'compaction/summary') continue
+    const receipt = event.data.recovered
+    if (event.data.compactionId !== input.originalCompactionId
+      && (receipt?.executionDomainId !== input.executionDomainId || receipt.requestId !== input.requestId)) continue
+    if (receipt === undefined && (summary.replayState === undefined
+      || !isDeepStrictEqual(event.data.replayState, summary.replayState))) {
+      throw new ManualCompactionError('changed', 'recovered summary association does not match the original checkpoint')
+    }
+    if (receipt !== undefined && (receipt.executionDomainId !== input.executionDomainId || receipt.requestId !== input.requestId
+      || receipt.providerResponseId !== input.providerResponseId
