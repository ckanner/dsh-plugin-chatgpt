+async function history(failedSummary = false, summaryTarget?: { summarizationProvider: string; summarizationModel: string }) {
+  const root = await mkdtemp(join(tmpdir(), 'dsh-summary-recovery-'))
+  const ctx = new Context()
+  onTestFinished(async () => { await ctx.fiber.dispose(); await rm(root, { recursive: true, force: true }) })
+  await mountAgentLoopTestDependencies(ctx, { workingDirectory: true })
+  await ctx.plugin(JsonlSessionPersistence, { root, compression: 'none' })
+  await ctx.plugin(TokenMeter)
+  await ctx.plugin(BasicCompactionEngine, { auto: false, ...summaryTarget })
+  await ctx.plugin(AgentLoop, { agents: [] })
+  const pro = brandString<ReasoningEffortId>('pro')
+  const summary: StreamChunk[] = [
+    ...textResponse('checkpoint').slice(0, -1),
+    { type: 'finish', reason: { kind: 'stop' }, replayState: { response: { requestId: 'summary-1', responseId: 'summary-response-1' } } },
+  ]
+  const adapter = new MockAdapter([
+    textResponse('first answer '.repeat(300)), textResponse('second answer '.repeat(300)),
+    failedSummary ? [{ type: 'finish', reason: { kind: 'error', failure: { code: 'TRANSPORT', message: 'lost captured summary delivery' } } }] : summary,
+  ], { efforts: [{ id: pro, name: 'Pro' }], defaultEffort: pro })
+  ctx.llm.registerAdapter(['old', 'web', 'summary'], adapter)
+  const agent = await ctx.agentLoop.create(brandString<SessionId>('summary-policy'), { provider: 'old', model: 'old-model' })
+  for (let i = 0; i < 2; i += 1) {
+    agent.followup(createUserMessage({ content: [{ type: 'text', text: `task ${i} `.repeat(300) }], source: { kind: 'user' } }))
+    await agent.whenIdle()
+  }
+  agent.model.select({ provider: 'web', model: 'web-model', reasoningEffort: pro })
+  return { ctx, agent, adapter, pro, summary }
+}
+
+async function pendingSummary() {
+  const fixture = await history(true)
+  const { ctx, agent, adapter, summary } = fixture
+  ctx.on('session/flush', () => {})
+  const surfaceSeqs = [...agent.session.surface.nodes]
+  await expect(ctx.compaction.compactNow(agent, new AbortController().signal)).rejects.toThrow('could not produce')
+  const operation = agent.session.snapshotEvents().findLast(event => event.type === 'compaction/start')!
+  if (operation.type !== 'compaction/start') throw new Error('missing original compaction')
+  const request = adapter.requests.at(-1)!
+  const selectedIds = new Set(request.messages.filter(message => message.role !== 'system' && 'id' in message).map(message => 'id' in message ? message.id : undefined))
+  const sourceEventSeqs = surfaceSeqs.filter((seq) => {
+    const event = agent.session.eventAt(seq)!
+    if (event.type === 'user/message') return selectedIds.has(event.data.id)
+    if (event.type === 'assistant/message') return selectedIds.has(event.data.message.id)
+    return false
+  })
+  const input: RecoveredSummaryInput = {
+    executionDomainId: 'summary-domain', requestId: 'summary-request', providerResponseId: 'summary-response',
+    responseDigest: recoveredResponseDigest(summary), request, originalCompactionId: operation.data.compactionId,
+    surfaceSeqs, sourceEventSeqs, chunks: summary,
+  }
+  return { ...fixture, input }
